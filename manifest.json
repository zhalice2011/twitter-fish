{
  "manifest_version": 3,
  "name": "Web Fish",
  "version": "3.0.0",
  "description": "Disguise X/Twitter and Linuxdo as VSCode — or just hide media",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "css": [
        "shared/css/vscode-shell.css",
        "shared/css/as-code.css",
        "sites/twitter/css/tweet-as-code.css"
      ],
      "js": [
        "shared/match.js",
        "core/registry.js",
        "core/style-toggle.js",
        "core/shell.js",
        "core/transformer.js",
        "sites/twitter/transformer.js",
        "sites/twitter/site.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://linux.do/*", "*://*.linux.do/*"],
      "css": [
        "shared/css/vscode-shell.css",
        "shared/css/as-code.css",
        "sites/linuxdo/css/post-as-code.css"
      ],
      "js": [
        "shared/match.js",
        "core/registry.js",
        "core/style-toggle.js",
        "core/shell.js",
        "core/transformer.js",
        "sites/linuxdo/transformer.js",
        "sites/linuxdo/site.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/vscode/*"],
      "matches": ["*://x.com/*", "*://twitter.com/*", "*://linux.do/*"]
    }
  ]
}
